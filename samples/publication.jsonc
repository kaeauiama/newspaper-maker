      { "type": "rule", "x": 0, "y": 137.743, "w": 34.3 },
      { "type": "text", "text": "架空の団体\n見本の\n機関紙", "font": "mincho", "weight": 600, "size": 10.5, "lineHeight": 1.4, "align": "justify", "x": 3, "y": 139.643, "w": 28.3, "h": 15.558 }
